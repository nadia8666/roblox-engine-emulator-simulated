+        let q0 = unit3(c0);
+        let d = dot3(q0, c1);
+        let q1 = unit3([c1[0] - d * q0[0], c1[1] - d * q0[1], c1[2] - d * q0[2]]);
+        let (d0, d1) = (dot3(q0, c2), dot3(q1, c2));
