+unsafe extern "C-unwind" fn clone_proxy(state: *mut mlua::ffi::lua_State) -> std::os::raw::c_int {
+    use mlua::ffi::*;
+    // UTAG_PROXY is reserved by Luau for newproxy, never Rust-owned userdata.
+    unsafe {
+        if lua_type(state, 1) != LUA_TUSERDATA || lua_userdatatag(state, 1) != LUA_UTAG_LIMIT + 1 {
+            luaL_error(state, c"proxy userdata required".as_ptr());
+        }
+        lua_newuserdatatagged(state, 0, LUA_UTAG_LIMIT + 1);
+        if lua_getmetatable(state, 1) != 0 {
+            lua_setmetatable(state, -2);
+        }
+    }
+    1
+}
