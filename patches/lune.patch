+fn load_native(
+    lua: &Lua,
+    (source, options): (LuaString, LuauLoadOptions),
+) -> LuaResult<LuaFunction> {
+    if options.inject_globals {
+        return Err(LuaError::runtime(
+            "native load requires injectGlobals=false",
+        ));
+    }
+    let custom = options
+        .environment
+        .ok_or(LuaError::runtime("native load requires environment"))?;
+    let environment = lua.create_table()?;
+    environment.set_metatable(custom.metatable())?;
+    for pair in custom.pairs() {
+        let (key, value): (LuaValue, LuaValue) = pair?;
+        environment.raw_set(key, value)?;
+    }
+    let mut names = std::collections::BTreeSet::<String>::new();
+    fn collect(
+        table: &LuaTable,
+        names: &mut std::collections::BTreeSet<String>,
+        depth: usize,
+    ) -> LuaResult<()> {
+        if depth > 16 {
+            return Err(LuaError::runtime("environment chain too deep"));
+        }
+        for pair in table.pairs::<LuaValue, LuaValue>() {
+            if let (LuaValue::String(key), _) = pair? {
+                names.insert(key.to_str()?.to_string());
+            }
+        }
+        if let Some(meta) = table.metatable() {
+            match meta.raw_get::<LuaValue>("__index")? {
+                LuaValue::Nil => (),
+                LuaValue::Table(parent) => collect(&parent, names, depth + 1)?,
+                _ => {
+                    return Err(LuaError::runtime(
+                        "native environment requires table __index",
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+    collect(&environment, &mut names, 0)?;
+    collect(&lua.globals(), &mut names, 0)?;
+    let bytes = mlua::Compiler::new()
+        .set_optimization_level(2)
+        .set_mutable_globals(names.into_iter())
+        .compile(source.as_bytes())?;
+    environment.set_safeenv(true);
+    let previous = lua.globals();
+    unsafe {
+        lua.exec_raw::<()>((environment.clone(),), |state| {
+            mlua::ffi::lua_replace(state, mlua::ffi::LUA_GLOBALSINDEX);
+        })?;
+    }
+    lua.enable_jit(true);
+    let loaded = lua
+        .load(bytes)
+        .set_name(options.debug_name)
+        .set_environment(environment)
+        .into_function();
+    unsafe {
+        lua.exec_raw::<()>((previous,), |state| {
+            mlua::ffi::lua_replace(state, mlua::ffi::LUA_GLOBALSINDEX);
+        })?;
+    }
+    lua.enable_jit(
+        lua.app_data_ref::<JitEnablement>()
+            .ok_or(LuaError::runtime("missing JIT setting"))?
+            .enabled(),
+    );
+    loaded
+}
