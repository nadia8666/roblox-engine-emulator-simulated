+        q[i] = s * 0.5;
+        let k = 0.5 / s;
+        q[3] = (r[k3][j] - r[j][k3]) * k;
+        q[j] = (r[j][i] + r[i][j]) * k;
+        q[k3] = (r[k3][i] + r[i][k3]) * k;
+        q
+    }
