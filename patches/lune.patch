+        Some("XZY") => ("XZY", EulerRot::XZY),
+        Some("YXZ") => ("YXZ", EulerRot::YXZ),
+        Some("YZX") => ("YZX", EulerRot::YZX),
+        Some("ZXY") => ("ZXY", EulerRot::ZXY),
+        Some("ZYX") => ("ZYX", EulerRot::ZYX),
