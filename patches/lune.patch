+    fn rot_from_quat(q: Quat) -> Rot {
+        let k = 1.0 / quat_dot(q, q).sqrt();
+        let [x, y, z, w] = q.map(|c| c * k);
+        let (x2, y2, z2) = (x + x, y + y, z + z);
+        let (xx, xy, xz) = (x * x2, x * y2, x * z2);
+        let (yy, yz, zz) = (y * y2, y * z2, z * z2);
+        let (wx, wy, wz) = (w * x2, w * y2, w * z2);
+        [
+            [1.0 - (yy + zz), xy - wz, xz + wy],
+            [xy + wz, 1.0 - (xx + zz), yz - wx],
+            [xz - wy, yz + wx, 1.0 - (xx + yy)],
+        ]
+    }
+
+    /// CFrame:Lerp's rotation: the first at t == 0 and the goal at t == 1 exactly, else the slerp of their quaternions
+    /// (the goal's negated when the dot is negative; `sinf((1 - t) w) / sin w` and `sinf(t w) / sin w`, sin w as
+    /// `sqrtf(1 - c*c)`), made a matrix again
+    pub fn lerp_rotation(a: &Rot, b: &Rot, t: f32) -> Rot {
+        if t == 0.0 {
+            return *a;
+        }
+        if t == 1.0 {
+            return *b;
+        }
+        let q0 = quat_from_rot(a);
+        let mut q1 = quat_from_rot(b);
+        let mut c = quat_dot(q0, q1);
+        if c < 0.0 {
+            q1 = q1.map(|v| -v);
+            c = -c;
+        }
+        let sin_omega = (1.0 - c * c).sqrt();
+        let omega = c.acos();
+        let k = 1.0 / sin_omega;
+        let w0 = ((1.0 - t) * omega).sin() * k;
+        let w1 = (t * omega).sin() * k;
+        rot_from_quat([0, 1, 2, 3].map(|i| q0[i] * w0 + q1[i] * w1))
+    }
