+// reports a growth of this thread's own stack or CallInfo array to the allocation callback, which walks the
+// frames: only once the thread points at the new block (luaM_realloc_ skips these), and a frame being set up
+// for the call that needs the room has no pc yet, so it is reported from its caller's
+static void reportthreadalloc(lua_State* L, void* block, size_t osize, size_t nsize, int fornewci)
+{
+    if (LUAU_LIKELY(!L->global->cb.onallocate))
+        return;
+
+    if (fornewci)
+        L->ci--;
+    luaP_allockind = LUA_ALLOC_THREAD;
+    L->global->cb.onallocate(L, block, osize, nsize, L->memcat, LUA_T_ALL, 0);
+    luaP_allockind = 0;
+    if (fornewci)
+        L->ci++;
+}
+
 void luaD_reallocstack(lua_State* L, int newsize, int fornewci)
 {
     // throw 'out of memory' error because space for a custom error message cannot be guaranteed here
@@ -202,6 +220,7 @@ void luaD_reallocstack(lua_State* L, int newsize, int fornewci)
 
     TValue* oldstack = L->stack;
     int realsize = newsize + EXTRA_STACK;
+    int oldsize = L->stacksize;
     LUAU_ASSERT(L->stack_last - L->stack == L->stacksize - EXTRA_STACK);
     luaM_reallocarray(L, L->stack, L->stacksize, realsize, TValue, L->memcat);
     TValue* newstack = L->stack;
@@ -210,15 +229,18 @@ void luaD_reallocstack(lua_State* L, int newsize, int fornewci)
     L->stacksize = realsize;
     L->stack_last = newstack + newsize;
     correctstack(L, oldstack);
+    reportthreadalloc(L, L->stack, size_t(oldsize) * sizeof(TValue), size_t(realsize) * sizeof(TValue), fornewci);
 }
 
 void luaD_reallocCI(lua_State* L, int newsize)
 {
     CallInfo* oldci = L->base_ci;
+    int oldsize = L->size_ci;
     luaM_reallocarray(L, L->base_ci, L->size_ci, newsize, CallInfo, L->memcat);
     L->size_ci = newsize;
     L->ci = (L->ci - oldci) + L->base_ci;
     L->end_ci = L->base_ci + L->size_ci - 1;
+    reportthreadalloc(L, L->base_ci, size_t(oldsize) * sizeof(CallInfo), size_t(newsize) * sizeof(CallInfo), 0);
 }
 
 void luaD_growstack(lua_State* L, int n)
