# Topic: imports resolve in the environment a chunk is loaded into
#
# What it does: luau_load (and luau_loadlazy, as it builds each function) resolves a chunk's imports (GETIMPORT) at load
# from the environment it is given, when that environment is safe, rather than from the loading thread's globals.
#
# Why upstream lacks it: Roblox loads each script on a thread whose globals are the script's environment, where
# upstream's L->gt is that table. A host that passes each script's environment to luau_load instead resolved nothing at
# load, so every import was a global lookup.

diff --git a/luau/VM/src/lvmload.cpp b/luau/VM/src/lvmload.cpp
index 7fe43fa..0937461 100644
--- a/luau/VM/src/lvmload.cpp
+++ b/luau/VM/src/lvmload.cpp
@@ -1031,7 +1031,10 @@ static int loadsafe(
         p->bytecodeid = int(i);
         p->funid = L->global->lastprotoid == 0 ? 0 : L->global->lastprotoid++;
 
-        loadProto(L, p, version, typesversion, userdataRemapping, loadStrings, loadProtos, envt, L->gt, data, size, offset);
+        // imports resolve in the environment the chunk is loaded into, when it is safe: a host that loads each script into an
+        // environment of its own (luau_load's env) resolves them as one that loads each script on a thread whose globals are that
+        // environment (Roblox's sandboxed script threads), where upstream's L->gt is that table
+        loadProto(L, p, version, typesversion, userdataRemapping, loadStrings, loadProtos, envt, envt, data, size, offset);
 
         if (version >= 12)
         {
@@ -1203,7 +1206,7 @@ static int loadlazysafe(lua_State* L, LuauLazyChunk* chunk, const char* chunknam
     main->funid = L->global->lastprotoid == 0 ? 0 : L->global->lastprotoid++;
 
     chunk->envt = envt;
-    chunk->importenv = L->gt;
+    chunk->importenv = envt; // (as luau_load resolves them: in the chunk's environment)
 
     buildLazyProto(L, chunk, main, chunk->envt, chunk->importenv);
 
