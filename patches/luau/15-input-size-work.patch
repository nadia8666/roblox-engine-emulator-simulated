index a99f723..14ba4d1 100644
--- a/luau/VM/src/lapi.cpp
+++ b/luau/VM/src/lapi.cpp
@@ -2,6 +2,10 @@
 // This code is based on Lua 5.x implementation licensed under MIT License; see lua_LICENSE.txt for details
 #include "lapi.h"
 
+#include <atomic>
+#include <mutex>
+#include <type_traits>
