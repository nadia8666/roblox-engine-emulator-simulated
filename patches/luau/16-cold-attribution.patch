+        code.active = c->active.size();
+        c->active.push_back(p);
+    }
+    int at = int(pc - p->code);
+    code.ran.push_back(at);
+    if (luaE_scriptwork(L))
+    {
+        luaC_touch(L, cl);
+        luaC_touch(L, p);
