+        total.kind = r.kind;
+        total.function = r.sitefunction;
+        total.pc = r.sitepc;
+        total.cost += r.cost;
+        total.frames++;
+        total.sharedframes += r.shared ? 1 : 0;
+        total.payers[(uint64_t(uint32_t(r.payer)) << 32) | uint32_t(r.pc)] += r.cost;
+        if (!r.shared && r.node >= 0 && size_t(r.node) < s->nodes.size())
