+    if (kind == LUA_COLD_TABLE)
+    {
+        auto site = s->tablesites.find(o);
+        if (site != s->tablesites.end())
+        {
+            record.sitefunction = int(int64_t(site->second) >> 32);
+            record.sitepc = int(uint32_t(site->second));
+        }
+    }
+    else if (kind == LUA_COLD_CFUNCTION)
