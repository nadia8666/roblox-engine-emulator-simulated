# Topic: tables hash objects by identity, not address
#
# What it does: a table key that is an object hashes by an id handed out the first time it is a key (an Instance
# userdata, tag 73, by its creation serial), so `pairs` visits a table keyed by objects in the same order in every run.
# REE_HASH_SEED=<n> deals a different order, the same in every run; REE_HASH_ADDRESS=1 hashes by address as upstream
# does.
#
# Why upstream lacks it: hashing by address is cheaper, and a game never depends on the order being reproducible.

diff --git a/luau/VM/src/lgc.cpp b/luau/VM/src/lgc.cpp
index 16b1fdd..bc04f29 100644
--- a/luau/VM/src/lgc.cpp
+++ b/luau/VM/src/lgc.cpp
@@ -780,6 +780,8 @@ static size_t cleartable(lua_State* L, GCObject* l)
 
 static void freeobj(lua_State* L, GCObject* o, lua_Page* page)
 {
+    if (o->gch.marked & bitmask(HASHIDBIT))
+        luaH_forgetid(o);
     switch (o->gch.tt)
     {
     case LUA_TPROTO:
@@ -827,6 +829,8 @@ static void freeobjtagged(lua_State* L, GCObject* o, lua_Page* page);
 template<>
 void freeobjtagged<LUA_TBUFFER>(lua_State* L, GCObject* o, lua_Page* page)
 {
+    if (o->gch.marked & bitmask(HASHIDBIT))
+        luaH_forgetid(o);
     luaB_freebuffer(L, gco2buf(o), page);
 }
 
