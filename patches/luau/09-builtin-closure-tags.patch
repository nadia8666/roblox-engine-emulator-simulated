     lua_pushnumber(L, LUAU_PI);
     lua_setfield(L, -2, "pi");
     lua_pushnumber(L, HUGE_VAL);
diff --git a/luau/VM/src/lobject.h b/luau/VM/src/lobject.h
index 7fe12bd..de9d176 100644
--- a/luau/VM/src/lobject.h
+++ b/luau/VM/src/lobject.h
@@ -494,6 +494,7 @@ typedef struct Closure
     uint8_t nupvalues;
     uint8_t stacksize;
     uint8_t preload;
+    uint8_t builtin; // Canonical C closure fastcall ID; zero for all other closures.
 
     GCObject* gclist;
     struct LuaTable* env;
@@ -516,6 +517,9 @@ typedef struct Closure
     };
 } Closure;
 
+static_assert(offsetof(Closure, builtin) == 7, "builtin tag must use existing closure padding");
+static_assert(offsetof(Closure, gclist) == 8, "closure pointer layout must remain unchanged");
+
 #define iscfunction(o) (ttype(o) == LUA_TFUNCTION && clvalue(o)->isC)
 #define isLfunction(o) (ttype(o) == LUA_TFUNCTION && !clvalue(o)->isC)
 
