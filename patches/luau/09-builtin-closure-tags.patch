# Topic: canonical builtins fast-called from native code through their closure
#
# What it does: the closures of math.floor, string.byte and table.insert carry their builtin id (in Closure's padding),
# and native code's call of such a closure runs the builtin's fast path, whatever name reached it.
#
# Why upstream lacks it: in a safe environment the compiler's FASTCALL already covers these calls.

diff --git a/luau/CodeGen/src/CodeGenUtils.cpp b/luau/CodeGen/src/CodeGenUtils.cpp
index c5b20e0..1353aa7 100644
--- a/luau/CodeGen/src/CodeGenUtils.cpp
+++ b/luau/CodeGen/src/CodeGenUtils.cpp
@@ -208,6 +208,20 @@ Closure* callProlog(lua_State* L, TValue* ra, StkId argtop, int nresults)
 
     Closure* ccl = clvalue(ra);
 
+    // The actual callee owns this tag, so inherited globals, aliases and argument
+    // side effects retain ordinary CALL semantics without trusting safeenv.
+    if (ccl->builtin != 0)
+    {
+        LUAU_ASSERT(ccl->isC && ccl->nupvalues == 0);
+        int nparams = int(argtop - ra - 1);
+        int n = luauF_table[ccl->builtin](L, ra, ra + 1, nresults, ra + 2, nparams);
+        if (n >= 0)
+        {
+            L->top = nresults == LUA_MULTRET ? ra + n : L->ci->top;
+            return nullptr;
+        }
+    }
+
     CallInfo* ci = incr_ci(L);
     ci->p = getproto(ccl);
     ci->func = ra;
diff --git a/luau/CodeGen/src/CodeGenUtils.h b/luau/CodeGen/src/CodeGenUtils.h
index 9fa3090..d770297 100644
--- a/luau/CodeGen/src/CodeGenUtils.h
+++ b/luau/CodeGen/src/CodeGenUtils.h
@@ -15,6 +15,7 @@ bool forgLoopNonTableFallback_DEPRECATED(lua_State* L, int insnA, int aux);
 
 void forgPrepXnextFallback(lua_State* L, TValue* ra, int pc);
 
+// Returns null when a tagged canonical C function completed without a call frame.
 Closure* callProlog(lua_State* L, TValue* ra, StkId argtop, int nresults);
 void callEpilogC(lua_State* L, int nresults, int n);
 
diff --git a/luau/CodeGen/src/EmitInstructionX64.cpp b/luau/CodeGen/src/EmitInstructionX64.cpp
index da18130..19cec9c 100644
--- a/luau/CodeGen/src/EmitInstructionX64.cpp
+++ b/luau/CodeGen/src/EmitInstructionX64.cpp
@@ -34,6 +34,10 @@ void emitInstCall(IrRegAllocX64& regs, AssemblyBuilderX64& build, ModuleHelpers&
     callWrapper.call(qword[rNativeContext + offsetof(NativeContext, callProlog)]);
     RegisterX64 ccl = rax; // Returned from callProlog
 
+    Label builtinDone;
+    build.test(ccl, ccl);
+    build.jcc(ConditionX64::Zero, builtinDone);
+
     emitUpdateBase(build);
 
     Label cFuncCall;
@@ -132,6 +136,7 @@ void emitInstCall(IrRegAllocX64& regs, AssemblyBuilderX64& build, ModuleHelpers&
             callWrapper.addArgument(SizeX64::dword, results);
             callWrapper.call(qword[rNativeContext + offsetof(NativeContext, callEpilogC)]);
             emitUpdateBase(build);
+            build.setLabel(builtinDone);
             return;
         }
 
@@ -171,6 +176,7 @@ void emitInstCall(IrRegAllocX64& regs, AssemblyBuilderX64& build, ModuleHelpers&
         build.mov(rax, qword[cip + offsetof(CallInfo, top)]);
         build.mov(qword[rState + offsetof(lua_State, top)], rax);
     }
+    build.setLabel(builtinDone);
 }
 
 void emitInstReturn(AssemblyBuilderX64& build, ModuleHelpers& helpers, int ra, int actualResults, bool functionVariadic)
